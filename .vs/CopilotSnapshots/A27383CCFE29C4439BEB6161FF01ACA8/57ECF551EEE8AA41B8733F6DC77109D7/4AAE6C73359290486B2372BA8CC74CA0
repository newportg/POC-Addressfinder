using AddressFinder.FunctionApp.Domain.Services;
using FluentAssertions;
using Xunit;

namespace AddressFinder.UnitTests;

public class CountryCodeNormalizationTests
{
    [Fact]
    public void ValidateAddressInput_ShouldAcceptTypicalUkAddress()
    {
        var sut = new InputValidationService();

        var error = sut.ValidateAddressInput("68 westfield road, woking, surrey, gu22 9ng");

        error.Should().BeNull();
    }

    [Fact]
    public void ValidateAddressInput_ShouldRejectMissingAddressInput()
    {
        var sut = new InputValidationService();

        var error = sut.ValidateAddressInput(null);

        error.Should().Be("INVALID_INPUT");
    }

    [Theory]
    [InlineData("us", "us")]
    [InlineData("US", "US")]
    [InlineData("USA", "USA")]
    [InlineData(" gbr ", "gbr")]
    [InlineData("ALB", "ALB")]
    [InlineData("NZL", "NZL")]
    [InlineData("New Zealand", "New Zealand")]
    public void NormalizeCountryCode_ShouldTrimInput(string input, string expected)
    {
        var sut = new InputValidationService();

        var normalized = sut.NormalizeCountryCode(input);

        normalized.Should().Be(expected);
    }

    [Theory]
    [InlineData("US")]
    [InlineData("GB")]
    [InlineData("ALB")]
    [InlineData("NZL")]
    [InlineData("New Zealand")]
    [InlineData("Albania")]
    public void ValidateCountryCode_ShouldAcceptIso2Iso3AndCountryNames(string input)
    {
        var sut = new InputValidationService();

        var error = sut.ValidateCountryCode(input);

        error.Should().BeNull();
    }

    [Theory]
    [InlineData(null)]
    [InlineData("")]
    [InlineData("   ")]
    [InlineData("12")]
    [InlineData("U1")]
    public void ValidateCountryCode_ShouldRejectInvalidInputs(string? input)
    {
        var sut = new InputValidationService();

        var error = sut.ValidateCountryCode(input);

        error.Should().Be("INVALID_COUNTRY");
    }
}
